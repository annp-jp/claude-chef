# chef のローカル設定（環境別の値）。
# このファイルをコピーして config/chef.local.yml を作り、自分の値を埋める。
#   cp config/chef.local.yml.example config/chef.local.yml
# config/chef.local.yml は .gitignore 済み（commit されない）。

# Googleカレンダーの登録先カレンダーID。未設定なら primary 扱い。
calendar_id: "your-id@gmail.com"

# ライフネットスーパーのログイン情報の参照（1Password）。
# 実値（パスワード）は 1Password にのみ存在。ここには参照だけ書く。
#   op item list で item を探し、op://<vault>/<item-id> を埋める。
#   その item に username / password フィールドがある前提。
life_netsuper:
  op_item: "op://<vault>/<item-id>"

# TypeSafe（Jev）の API キーの参照（1Password）。/chef order の商品選びの判定に使う。
# 環境変数 TYPESAFE_API_KEY があればそちらを優先する。
typesafe:
  op_ref: "op://<vault>/<item-id>/credential"

# /chef order の商品選び。Claude が判定するときに読む（上から優先）。
# minimum_order_yen はライフの最低注文金額（税抜）。下回ったら完了報告で知らせる。
order:
  minimum_order_yen: 2000
  selection_rules:
    - 材料として適していること（味付き・加工品・別の食材は選ばない）
    - 冷凍品は、項目に「冷凍」と書いてあるときだけ選ぶ
    - 量の指定があるときは、必要量以上で最小の組み合わせにする（グラム売りは目安の重さで数える）。同じ量なら安い方
    - お肉は1パックで満たせるものを選ぶ。1パックで足りるものが無ければ組み合わせて入れ、完了報告でそのことを知らせる
    - いつもの商品（注文履歴にある商品）があれば優先する。もっと安い候補があれば完了報告で伝える
    - いつもの商品がなく量の指定もないときは、1g・1ml あたりが最も安いものにする
    - 産地は問わない
  # 買わずに在庫確認へ回すもの。省略時は pantry_categories: [調味料]。
  # pantry_items は品目名の一部が一致すれば対象（例: 「にんにく」→「にんにくの薄切り」も対象）
  pantry_categories:
    - 調味料
  pantry_items:
    - だし
    - 乾燥わかめ
  # 品目ごとの指定（品目名の一部が一致すれば適用。検索語と判定に使う）
  item_notes:
    たけのこ: 水煮（下ごしらえ済み）を選ぶ
